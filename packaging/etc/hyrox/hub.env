# HYROX Central Hub configuration (ADR 0009 §5).
#
# systemd reads this into the service's environment. There is no configuration file format
# and no parser in the hub: it already reads its settings from the environment, and systemd
# already reads files into it.
#
# After editing:  systemctl restart hyrox-hub

# The venue LAN, so coaches reach /workout and /checkin from their own phones. There is no
# login -- the network boundary is this deployment's job (ADR 0001 D1), so this port belongs
# on a segment only staff devices can reach.
HYROX_BIND=0.0.0.0:8730

HYROX_DB=sqlite:///var/lib/hyrox/hyrox.db

HYROX_MQTT_HOST=127.0.0.1
HYROX_MQTT_PORT=1883
# Stable on purpose: the broker holds this client's QoS 1 queue while the hub is down, so
# events published during a restart arrive afterwards rather than being lost.
HYROX_MQTT_CLIENT_ID=hyrox-hub

# No emulated hardware on a real venue machine.
# Demo data (a fixture class and emulated reads) is a test-machine tool. Leave it unset on
# a venue machine: the settings screen then shows no demo section at all.
# HYROX_DEMO=1

# What the projector shows. `?lang=` pins the screen's language; the machine remembers it
# afterwards (roadmap M7). Read by hyrox-kiosk.service.
HYROX_SCREEN_URL=http://127.0.0.1:8730/live?lang=zh-Hant

# Off-machine copy of the backups (ADR 0012). Uncomment after labelling a USB stick
# HYROXBACKUP and enabling media-hyroxbackup.mount. Once set, a stick that is missing at
# backup time is a failed unit rather than a silent gap -- which is the point of setting it.
#HYROX_BACKUP_MIRROR=/media/hyroxbackup
